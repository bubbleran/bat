[project]
name = "__BLUEPRINT_NAME__"
version = "1.0.0"
description = "__BLUEPRINT_DESCRIPTION__"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "bat-adk[__BAT_ADK_EXTRAS__]>=__BAT_ADK_VERSION__"
]

[dependency-groups]
